{
  "info": {
    "name": "Lab07 - JSONPlaceholder API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Bộ kiểm thử REST API (CRUD) bằng Postman. Đổi biến baseUrl để trỏ sang https://jsonplaceholder.typicode.com."
  },
  "item": [
    {
      "name": "01 GET - Lấy danh sách posts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Body là mảng không rỗng\", () => { const j = pm.response.json(); pm.expect(j).to.be.an(\"array\").that.is.not.empty; });",
              "pm.test(\"Mỗi post có đủ userId, id, title, body\", () => pm.response.json().forEach(p => pm.expect(p).to.include.all.keys(\"userId\",\"id\",\"title\",\"body\")));",
              "pm.test(\"Thời gian phản hồi < 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        }
      }
    },
    {
      "name": "02 GET - Lấy post theo id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"id = 1\", () => pm.expect(pm.response.json().id).to.eql(1));",
              "pm.test(\"Content-Type là JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Thời gian phản hồi < 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      }
    },
    {
      "name": "03 GET - Lọc posts theo userId",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Tất cả post thuộc userId = 1\", () => pm.response.json().forEach(p => pm.expect(p.userId).to.eql(1)));",
              "pm.test(\"Thời gian phản hồi < 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts?userId=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ],
          "query": [
            {
              "key": "userId",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "name": "04 GET - Lấy comments của một post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Tất cả comment thuộc postId = 1\", () => pm.response.json().forEach(c => pm.expect(c.postId).to.eql(1)));",
              "pm.test(\"Thời gian phản hồi < 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/1/comments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1",
            "comments"
          ]
        }
      }
    },
    {
      "name": "05 POST - Tạo post mới",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
              "pm.test(\"Dữ liệu trả về khớp dữ liệu gửi\", () => { const j = pm.response.json(); pm.expect(j.title).to.eql(\"Kiểm thử Postman\"); pm.expect(j.userId).to.eql(1); });",
              "pm.test(\"Server cấp id mới\", () => pm.expect(pm.response.json().id).to.be.a(\"number\"));",
              "pm.collectionVariables.set(\"newPostId\", pm.response.json().id);",
              "pm.test(\"Thời gian phản hồi < 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Kiểm thử Postman\",\n  \"body\": \"Bài thực hành Lab07\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        }
      }
    },
    {
      "name": "06 PUT - Cập nhật toàn bộ post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Title đã được cập nhật\", () => pm.expect(pm.response.json().title).to.eql(\"Tiêu đề đã sửa\"));",
              "pm.test(\"Thời gian phản hồi < 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Tiêu đề đã sửa\",\n  \"body\": \"Nội dung đã sửa\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      }
    },
    {
      "name": "07 PATCH - Cập nhật một phần",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Chỉ title thay đổi, id giữ nguyên\", () => { const j = pm.response.json(); pm.expect(j.title).to.eql(\"Tiêu đề patch\"); pm.expect(j.id).to.eql(1); });",
              "pm.test(\"Thời gian phản hồi < 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Tiêu đề patch\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      }
    },
    {
      "name": "08 DELETE - Xoá post vừa tạo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Thời gian phản hồi < 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/{{newPostId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{newPostId}}"
          ]
        }
      }
    },
    {
      "name": "09 GET - Post đã xoá trả về 404 (negative test)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404 Not Found\", () => pm.response.to.have.status(404));",
              "pm.test(\"Thời gian phản hồi < 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "Kiểm thử âm: tài nguyên đã xoá phải không còn truy cập được.",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/{{newPostId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{newPostId}}"
          ]
        }
      }
    },
    {
      "name": "10 GET - id không tồn tại trả về 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404 Not Found\", () => pm.response.to.have.status(404));",
              "pm.test(\"Thời gian phản hồi < 1000ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/99999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "99999"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "newPostId",
      "value": ""
    }
  ]
}